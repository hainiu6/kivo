        "responses": {
          "200": {
            "description": "已更新",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "消息编号无效或不属于此会话"
          },
          "401": {
            "description": "凭证无效、已过期或已撤销"
          },
          "403": {
            "description": "网页来源不允许"
          },
          "404": {
            "description": "会话不存在"
          },
          "429": {
            "description": "请求过于频繁"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "userId",
          "account"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "account": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "nickname": {
            "type": "string",
            "maxLength": 80,
            "default": ""
          },
          "attributes": {
            "type": "object",
            "maxProperties": 5,
            "propertyNames": {
              "minLength": 1,
              "maxLength": 32
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      },
      "Client": {
        "type": "object",
        "required": [
          "platform"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "Windows",
              "macOS",
              "Linux",
              "Android",
              "iOS",
              "Other"
            ]
          },
          "version": {
            "type": "string",
            "maxLength": 40
          },
          "device": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Token": {
        "type": "object",
        "required": [
          "token",
          "expiresAt"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer",
            "description": "UTC Unix 秒"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "conversationId",
          "accessToken",
          "expiresAt",
          "user",
          "support",
          "socket"
        ],
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "support": {
            "type": "object",
            "properties": {
              "supportName": {
                "type": "string"
              },
              "avatarId": {
                "type": "string"
              },
              "avatarUrl": {
                "type": "string"
              },
              "online": {
                "type": "boolean"
              }
            }
          },
          "socket": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "protocol": {
                "type": "string"
              }
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "sender",
          "body",
          "client_id",
          "created_at",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "sender": {
            "enum": [
              "visitor",
              "agent",
              "auto"
            ]
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "integer",
            "description": "Unix 毫秒"
          },
          "kind": {
            "enum": [
              "text",
              "image",
              "sticker"
            ]
          },
          "media_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sticker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "read_at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "用户首次查看时间，Unix 毫秒；未读为 null"
          }
        }
      },
      "MessageInput": {
        "type": "object",
        "required": [
          "clientId"
        ],
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "text",
              "image",
              "sticker"
            ],
            "default": "text"
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "mediaId": {
            "type": "string",
            "format": "uuid"
          },
          "stickerId": {
            "type": "string"
          }
        },
        "description": "text 正文必填；image mediaId 必填；sticker stickerId 必填。重试使用相同 clientId。"
      },
      "History": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextBefore": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Media": {
        "type": "object",
        "required": [
          "id",
          "width",
          "height",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          }
        }
      },
      "OK": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "const": true
          }
        }
      }
    },
    "securitySchemes": {
      "backendKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "仅业务后端持有的站点64位签名密钥"
      },
      "clientBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "业务后端签发的短期客户端凭证"
      },
      "siteId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Kivo-Site",
        "description": "后台站点 UUID"
      }
    }
  }
}
