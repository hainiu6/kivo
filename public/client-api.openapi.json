{
  "openapi": "3.1.0",
  "info": {
    "title": "Kivo 客户端 API",
    "version": "1.13.1",
    "description": "Windows / macOS / Linux / Android / iOS 通用 HTTPS 接口。长期密钥留在业务后端；用户凭证最多 15 分钟。实时 Socket.IO 协议见文档。"
  },
  "servers": [
    {
      "url": "https://kivo.2222255.xyz",
      "description": "客服服务地址；替换成你的部署域名"
    }
  ],
  "externalDocs": {
    "description": "HTTP 接入流程、Socket.IO 事件及示例",
    "url": "https://github.com/hainiu6/kivo/blob/main/docs/client-api.md"
  },
  "paths": {
    "/api/client/v1/tokens": {
      "post": {
        "summary": "业务后端签发客户端短期凭证，禁止浏览器 Origin",
        "security": [
          {
            "backendKey": []
          }
        ],
        "responses": {
          "201": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "凭证无效、过期或撤销",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "来源不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "会话或图片不存在 / 无权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求过大",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过频繁，按 Retry-After 退避",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "siteId",
                  "user"
                ],
                "properties": {
                  "siteId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "user": {
                    "$ref": "#/components/schemas/User"
                  },
                  "ttl": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 900,
                    "default": 900
                  }
                }
              }
            }
          }
        }
      }
    },
