PUBLIC_URL=http://localhost:8080
PORT=3000
DATA_DIR=./data
ADMIN_USERNAME=admin
# Set a unique password (at least 12 characters) BEFORE the first start.
ADMIN_PASSWORD=
# 0 for local Node; 1 only behind the bundled Caddy proxy.
TRUST_PROXY=0
HTTP_PORT=8080
HTTPS_PORT=443
# For automatic HTTPS: CADDY_SITE=chat.example.com, PUBLIC_URL=https://chat.example.com, HTTP_PORT=80
CADDY_SITE=:80
