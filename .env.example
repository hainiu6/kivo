PUBLIC_URL=http://localhost:8088
PORT=3000
DATA_DIR=./data
ADMIN_USERNAME=admin
# Set a unique password (at least 12 characters) BEFORE the first start.
ADMIN_PASSWORD=
# 0 for direct Docker/Node access; 1 behind a trusted reverse proxy only.
TRUST_PROXY=0
HTTP_PORT=8088
BIND_HOST=0.0.0.0
# The following options are only used by the optional legacy Compose setup.
HTTPS_PORT=8443
# For automatic HTTPS: CADDY_SITE=chat.example.com, PUBLIC_URL=https://chat.example.com, HTTP_PORT=80
CADDY_SITE=:80
